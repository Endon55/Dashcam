{
  "version": 2,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "environment": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-overlay/triplets"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "DBUS_SESSION_SOCKET_DIR": "/tmp"
      }
    },
    {
      "name": "vcpkg",
      "inherits": [
        "base"
      ],
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "inherits": [
        "vcpkg"
      ],
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vcpkg-arm",
      "inherits": [
        "base"
      ],
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release/arm",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_CHAIN_LOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/aarch64-pi-toolchain.cmake",
        "CMAKE_SYSROOT": "$env{HOME}/pi-sysroot",
        "VCPKG_TARGET_TRIPLET": "arm64-linux",
        "CMAKE_C_FLAGS": "-march=armv8-a -mtune=generic",
        "CMAKE_CXX_FLAGS": "-march=armv8-a -mtune=generic"
      }
    },
    {
      "name": "debug-arm",
      "inherits": [
        "base"
      ],
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug/arm",
      "cacheVariables": {
        "VCPKG_CHAIN_LOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/aarch64-pi-toolchain.cmake",
        "CMAKE_SYSROOT": "$env{HOME}/pi-sysroot",
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "arm64-linux",
        "CMAKE_C_FLAGS": "-march=armv8-a -mtune=generic",
        "CMAKE_CXX_FLAGS": "-march=armv8-a -mtune=generic"
      }
    }
  ]
}